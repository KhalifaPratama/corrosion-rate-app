# Auto detect text files and normalize line endings to LF in repository
* text=auto

# Force LF for these files
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Force CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.pkl binary
*.joblib binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary

# Jupyter notebooks - treat as text but don't normalize (keep as is)
*.ipynb text eol=lf

# CSS/JS
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf
