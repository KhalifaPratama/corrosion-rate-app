# Salin file ini menjadi '.env' lalu isi nilainya.
# '.env' sudah masuk .gitignore dan TIDAK BOLEH di-commit.

# Flask Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False

# Database (dipakai notebook training untuk mengambil data)
# Isi sesuai konfigurasi internal — jangan tulis nilai aslinya di file ini.
DB_HOST=alamat_host_database
DB_PORT=5432
DB_NAME=nama_database
DB_USER=nama_user
DB_PASSWORD=isi_password_disini

# For Production, use production WSGI server instead of Flask dev server
# Example: gunicorn -w 4 -b 0.0.0.0:5000 app:app
